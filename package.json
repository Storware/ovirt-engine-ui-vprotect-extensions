{
  "name": "ovirt-engine-vprotect-extension",
  "version": "8.0.0-1",
  "license": "Apache-2.0",
  "repository": {
    "type": "git"
  },
  "scripts": {
    "start": "webpack serve --config webpack.dev.js",
    "prettify": "prettier --write \"**/*.ts*\"",
    "lint:fix": "eslint --fix --ext .js,.jsx,.ts,.tsx .",
    "zip:oVirt": "cd dist/oVirt && zip -r oVirt.zip ./*",
    "zip:openstack": "cd dist/openstack && zip -r openstack.zip ./*",
    "prebuild:oVirt": "rm -rf dist/oVirt",
    "build:oVirt": "webpack --config webpack.ovirt.prod.js",
    "prebuild:openstack": "rm -rf dist/openstack",
    "build:openstack": "webpack --config webpack.openstack.prod.js",
    "build-n-zip:oVirt": "yarn build:oVirt && yarn zip:oVirt",
    "build-n-zip:openstack": "yarn build:openstack && yarn zip:openstack",
    "build-n-zip": "yarn build-n-zip:oVirt && yarn build-n-zip:openstack",
    "build-release": "bash ./build-n-zip.sh"
  },
  "dependencies": {
    "@patternfly/react-charts": "^6.94.21",
    "@patternfly/react-core": "^4.278.1",
    "@reduxjs/toolkit": "^1.9.7",
    "@types/react-redux": "^7.1.7",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "bootstrap": "5.3.8",
    "chart.js": "^3.9.1",
    "classnames": "^2.5.1",
    "file-saver": "^2.0.5",
    "formik": "^2.4.9",
    "history": "^5.0.0",
    "jquery": "^3.7.1",
    "moment": "^2.31.0",
    "moment-timezone": "^0.6.5",
    "primeicons": "^5.0.0",
    "primereact": "^8.7.3",
    "prop-types": "^15.6.0",
    "react": "^17.0.2",
    "react-chartjs-2": "^3.0.5",
    "react-dom": "^17.0.2",
    "react-notifications-component": "^3.4.1",
    "react-redux": "^7.2.9",
    "react-router-dom": "^5.3.4",
    "redux-thunk": "^2.4.2",
    "sass": "^1.107.0"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^13.5.0",
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@types/prop-types": "^15.7.3",
    "@types/react": "17.0.40",
    "@typescript-eslint/eslint-plugin-tslint": "^5.62.0",
    "babel-loader": "^8.4.1",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^5.0.4",
    "core-js": "^3.51.0",
    "css-loader": "^3.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.2",
    "eslint-config-standard": "^11.0.0-beta.0",
    "eslint-config-standard-jsx": "^4.0.2",
    "eslint-config-standard-react": "^5.0.0",
    "eslint-loader": "^4.0.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^5.2.1",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-prettier": "^4.2.5",
    "eslint-plugin-promise": "^3.6.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-standard": "^3.0.1",
    "eslint-webpack-plugin": "^3.2.0",
    "file-loader": "^4.1.0",
