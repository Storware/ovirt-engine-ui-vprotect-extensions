{
  "name": "ovirt-engine-vprotect-extension",
  "version": "8.0.0-1",
  "license": "Apache-2.0",
  "repository": {
    "type": "git"
  },
  "scripts": {
    "start": "webpack serve --config webpack.dev.js",
    "prettify": "prettier --write \"**/*.ts*\"",
    "lint:fix": "eslint --fix --ext .js,.jsx,.ts,.tsx .",
    "zip:oVirt": "cd dist/oVirt && zip -r oVirt.zip ./*",
    "zip:openstack": "cd dist/openstack && zip -r openstack.zip ./*",
    "prebuild:oVirt": "rm -rf dist/oVirt",
    "build:oVirt": "webpack --config webpack.ovirt.prod.js",
    "prebuild:openstack": "rm -rf dist/openstack",
    "build:openstack": "webpack --config webpack.openstack.prod.js",
    "build-n-zip:oVirt": "yarn build:oVirt && yarn zip:oVirt",
    "build-n-zip:openstack": "yarn build:openstack && yarn zip:openstack",
    "build-n-zip": "yarn build-n-zip:oVirt && yarn build-n-zip:openstack",
    "build-release": "bash ./build-n-zip.sh",
    "test": "playwright test --headed",
    "test:headless": "playwright test",
    "test:update": "playwright test --update-snapshots=all"
  },
  "dependencies": {
    "@patternfly/react-charts": "^6.67.1",
