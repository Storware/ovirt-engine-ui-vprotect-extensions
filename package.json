    "primereact": "^8.2.0",
    "prop-types": "^15.6.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^4.3.1",
    "react-dom": "^18.3.1",
    "react-notifications-component": "^4.0.1",
    "react-redux": "^7.2.9",
    "react-router-dom": "^5.3.4",
    "redux": "^4.2.1",
    "redux-thunk": "^2.4.2",
