    "terser-webpack-plugin": "^5.6.1",
    "ts-loader": "^7.0.4",
    "tslint": "^6.1.2",
    "tslint-webpack-plugin": "^2.1.0",
    "typescript": "^3.9.3",
    "url-loader": "^2.1.0",
    "webpack": "^5.112.2",
